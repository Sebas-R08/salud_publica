<%- include('../layout') %>

<div class="container mt-4">
  <h2 class="text-center mb-3"><%= titulo %></h2>
  <div class="text-end mb-3">
    <a href="/pacientes/nuevo" class="btn btn-primary">➕ Nuevo Paciente</a>
  </div>

  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Documento</th>
        <th>Fecha Nacimiento</th>
        <th>Dirección</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% pacientes.forEach(p => { %>
        <tr>
          <td><%= p.id_paciente %></td>
          <td><%= p.nombre %></td>
          <td><%= p.tipo %></td>
          <td><%= p.documento %></td>
          <td><%= p.fecha_nacimiento %></td>
          <td><%= p.direccion %></td>
          <td>
            <a href="/pacientes/editar/<%= p.id_paciente %>" class="btn btn-sm btn-warning">✏️</a>
            <a href="#" class="btn btn-danger btn-sm" onclick="confirmDelete('/pacientes/eliminar/<%= p.id_paciente %>')">🗑️</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
 
</div>
<%- include('../footer') %>
