<%- include('../layout') %>

<div class="container mt-4">
  <h2 class="text-center mb-3"><%= titulo %></h2>
  <div class="text-end mb-3">
    <a href="/vacunas/nuevo" class="btn btn-success">➕ Nueva Vacuna</a>
  </div>

  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Laboratorio</th>
        <th>Dosis Requeridas</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% vacunas.forEach(v => { %>
        <tr>
          <td><%= v.id_vacuna %></td>
          <td><%= v.nombre %></td>
          <td><%= v.laboratorio %></td>
          <td><%= v.dosis %></td>
          <td>
            <a href="/vacunas/editar/<%= v.id_vacuna %>" class="btn btn-warning btn-sm">✏️</a>
            <a href="#" class="btn btn-danger btn-sm" onclick="confirmDelete('/vacunas/eliminar/<%= v.id_vacuna %>')">🗑️</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../footer') %>
