<%- include('../layout') %>

<div class="container mt-4">
  <h2><%= titulo %></h2>
  <form id="formVacuna">
    <div class="mb-3">
      <label class="form-label">Nombre:</label>
      <input type="text" name="nombre" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Laboratorio:</label>
      <input type="text" name="laboratorio" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Dosis requeridas:</label>
      <input type="number" name="dosis_requeridas" class="form-control" required>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a href="/vacunas" class="btn btn-secondary">Cancelar</a>
  </form>
</div>

<script>
  document.getElementById('formVacuna').addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new URLSearchParams(new FormData(e.target));
    const res = await fetch('/vacunas/nuevo', { method: 'POST', body: data });
    if (res.ok) {
      showSuccess('Vacuna registrada correctamente', '/vacunas');
    } else {
      showError('Error al registrar la vacuna');
    }
  });
</script>

<%- include('../footer') %>
