<%- include('../layout') %>

<div class="container mt-4">
  <h2 class="text-center mb-3"><%= titulo %></h2>
  <div class="text-end mb-3">
    <a href="/registros/nuevo" class="btn btn-success">➕ Nuevo Registro</a>
  </div>

  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Paciente</th>
        <th>Vacuna</th>
        <th>Lote</th>
        <th>Aplicado por</th>
        <th>Fecha</th>
        <th>Observaciones</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      <% registros.forEach(r => { %>
        <tr>
          <td><%= r.id_registro %></td>
          <td><%= r.Paciente?.nombre || '—' %></td>
          <td><%= r.Vacuna?.nombre || '—' %></td>
          <td><%= r.Lote?.codigo_lote || '—' %></td>
          <td><%= r.Usuario?.nombre || '—' %></td>
          <td><%= r.fecha_vacunacion %></td>
          <td><%= r.observaciones || '' %></td>
          <td>
            <a href="#" class="btn btn-danger btn-sm" onclick="confirmDelete('/registros/eliminar/<%= r.id_registro %>')">🗑️</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../footer') %>
